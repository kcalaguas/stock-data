# Alpaca Markets — get free keys at https://alpaca.markets
# Paper trading keys work for market data
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Set to "true" if you have a live brokerage account (enables real-time data)
# Set to "false" for paper/delayed data
ALPACA_LIVE=false

# Optional: email alerts via Gmail SMTP
# Enable "App Passwords" in your Google account security settings
ALERT_EMAIL_ENABLED=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_TO_EMAIL=you@gmail.com

# Watchlist — comma-separated tickers
WATCHLIST=AAPL,MSFT,NVDA,SPY,QQQ

# Dashboard port
PORT=8000
